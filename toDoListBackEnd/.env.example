NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Firebase project ID (Project settings > General in the Firebase console).
GOOGLE_CLOUD_PROJECT=
# Optional: absolute path to a service account JSON stored outside this repository.
# Omit when using gcloud Application Default Credentials or a managed Google runtime.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
